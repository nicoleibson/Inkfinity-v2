# Gemini AI (Server-Side Only)
GEMINI_API_KEY=

# Durabilidad de obras NFT: Cloud Storage (Firebase Storage).
# El bucket se resuelve de NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET (o FIREBASE_STORAGE_BUCKET).
# En App Hosting la service account del proyecto se usa automaticamente (ADC).
# Para desarrollo local con credencial propias de la cuenta, crea una service account
# con rol Storage Object Admin y exporta estas dos variables:
FIREBASE_STORAGE_BUCKET=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# RPC endpoints para la verificación on-chain de propiedad NFT (server-side).
# Si se dejan vacíos se usan los RPC públicos (rate-limited).
RPC_AMOY_URL=
RPC_POLYGON_URL=

# Server-side RPC for payment verification (optional; public fallbacks used if empty)
RPC_AMOY_URL=https://rpc-amoy.polygon.technology
RPC_POLYGON_URL=https://polygon-rpc.com
# WorldChain. El default del código es el endpoint /public de Alchemy, que RECHAZA
# eth_getUserOperationByHash; usa una URL con API key (/v2/<KEY>).
RPC_WORLDCHAIN_URL=https://worldchain-mainnet.g.alchemy.com/v2/
RPC_WORLDCHAIN_SEPOLIA_URL=https://worldchain-sepolia.g.alchemy.com/v2/

# Bundler para verificar el destinatario (to) e importe (value) EXACTOS de una
# userOp (ERC-4337). Alchemy lo soporta en World Chain (mainnet y sepolia).
# Sin esto, los pagos de la World App se validan con un delta de saldo del
# receptor en el bloque de liquidación: sigue siendo correcto, pero no comprueba
# to/value. Formato: endpoint JSON-RPC de Alchemy con API key.
RPC_WORLDCHAIN_BUNDLER_URL=
RPC_WORLDCHAIN_SEPOLIA_BUNDLER_URL=

# Precio de referencia para depósitos de reserva (denominados en USD).
# Debe ser un endpoint compatible con CoinGecko simple/price: el código le añade
# ?ids=<coin>&vs_currencies=usd. Si el servidor no consigue precio, responde
# PRICE_UNAVAILABLE y no liquida el depósito.
PRICE_API_BASE_URL=https://api.coingecko.com/api/v3/simple/price

# Solo desarrollo local: habilita el precio fijo heredado (3500 USD). NUNCA en producción.
ALLOW_MOCK_PRICES=
