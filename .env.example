# Durabilidad de obras NFT: Cloud Storage (Firebase Storage).
# El bucket se resuelve de NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET (o FIREBASE_STORAGE_BUCKET).
# En App Hosting la service account del proyecto se usa automaticamente (ADC).
# Para desarrollo local con credencial propias de la cuenta, crea una service account
# con rol Storage Object Admin y exporta estas dos variables:
FIREBASE_STORAGE_BUCKET=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# RPC endpoints para la verificación on-chain de propiedad NFT (server-side).
# Si se dejan vacíos se usan los RPC públicos (rate-limited).
RPC_AMOY_URL=
RPC_POLYGON_URL=

# Server-side RPC for payment verification (optional; public fallbacks used if empty)
RPC_AMOY_URL=https://rpc-amoy.polygon.technology
RPC_POLYGON_URL=https://polygon-rpc.com
