{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": true,
      ".indexOn": [
        "role",
        "studioId",
        "artistRequestStatus",
        "email",
        "walletAddress",
        "claimedRewards/feature_slot",
        "referredBy",
        "name"
      ],
      "$uid": {
        ".read": "auth != null && ( ( !data.child('isPrivate').exists() || data.child('isPrivate').val() === false ) || (auth.uid === $uid) || (data.child('followersList').hasChild(auth.uid)) || (root.child('users').child(auth.uid).child('role').exists() && (root.child('users').child(auth.uid).child('role').val() === 'Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator')))",
        ".write": "auth != null && (auth.uid === $uid || (root.child('users').child(auth.uid).child('role').exists() && (root.child('users').child(auth.uid).child('role').val() === 'Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator')))",
        ".validate": "!data.exists() || (auth != null && (root.child('users').child(auth.uid).child('role').exists() && (root.child('users').child(auth.uid).child('role').val() === 'Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator'))) || newData.child('status').val() !== 'active' || data.child('status').val() === 'active'",
        "fcmTokens": {
          ".write": "auth != null && auth.uid === $uid"
        },
        "status": {
          ".validate": "auth != null && (root.child('users').child(auth.uid).child('role').exists() && (root.child('users').child(auth.uid).child('role').val() === 'Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator') || (!data.exists() && newData.exists() && (newData.val() === 'active' || newData.val() === 'pending_verification' || newData.val() === 'pending_payment')) || (auth.uid === $uid && newData.val() === 'pending_payment'))"
        },
        "role": {
          ".validate": "auth != null && (root.child('users').child(auth.uid).child('role').exists() && (root.child('users').child(auth.uid).child('role').val() === 'Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator') || (!data.exists() && newData.exists() && (newData.val() === 'Client' || newData.val() === 'Tattoo Artist' || newData.val() === 'Studio' || newData.val() === 'Supply Store')))"
        },
        "paymentDate": {
          ".validate": "auth != null && (root.child('users').child(auth.uid).child('role').exists() && (root.child('users').child(auth.uid).child('role').val() === 'Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator'))"
        },
        "paymentTxHash": {
          ".validate": "auth != null && (root.child('users').child(auth.uid).child('role').exists() && (root.child('users').child(auth.uid).child('role').val() === 'Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator'))"
        },
        "worldIdVerified": {
          ".validate": "auth != null && (root.child('users').child(auth.uid).child('role').exists() && (root.child('users').child(auth.uid).child('role').val() === 'Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator'))"
        },
        "worldIdVerifiedAt": {
          ".validate": "auth != null && (root.child('users').child(auth.uid).child('role').exists() && (root.child('users').child(auth.uid).child('role').val() === 'Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator'))"
        },
        "referredBy": {
          ".validate": "auth != null && (root.child('users').child(auth.uid).child('role').exists() && (root.child('users').child(auth.uid).child('role').val() === 'Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator'))"
        },
        "referralEarnings": {
          ".validate": "auth != null && (root.child('users').child(auth.uid).child('role').exists() && (root.child('users').child(auth.uid).child('role').val() === 'Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator'))",
          ".read": true
        },
        "referralPayouts": {
          ".validate": "auth != null && (root.child('users').child(auth.uid).child('role').exists() && (root.child('users').child(auth.uid).child('role').val() === 'Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator'))"
        },
        "referralCodeUsed": {
          ".validate": "auth != null && (root.child('users').child(auth.uid).child('role').exists() && (root.child('users').child(auth.uid).child('role').val() === 'Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator') || (!data.exists() && newData.val() === false))"
        },
        "referralCodeUsedDate": {
          ".validate": "auth != null && (root.child('users').child(auth.uid).child('role').exists() && (root.child('users').child(auth.uid).child('role').val() === 'Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator'))"
        },
        "referralCode": {
          ".write": "auth != null && auth.uid === $uid && newData.exists() && newData.val() != ''"
        },
        "referralCodeUsedBy": {
          ".write": "root.child('referralCodeUsed').child(newData.val()).exists() === true"
        },
        "referralCount": {
          ".write": "auth != null && auth.uid === $uid && newData.exists() && newData.val() != ''"
        },
        "isActiveForGeofencing": {
          ".validate": "auth != null && (root.child('users').child(auth.uid).child('role').exists() && (root.child('users').child(auth.uid).child('role').val() === 'Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator'))"
        },
        "referralCodeOwned": {
          ".write": "auth != null && auth.uid === $uid && newData.exists() && newData.val() != ''"
        },
        "referralCodeCorrect": {
          ".write": "auth != null && auth.uid === $uid && newData.exists() && newData.val() != ''"
        },
        "referralPayoutsDate": {
          ".validate": "auth != null && (root.child('users').child(auth.uid).child('role').exists() && (root.child('users').child(auth.uid).child('role').val() === 'Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator'))"
        }
      }
    },
    "usernames": {
      ".read": true,
      "$username": {
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid || (root.child('users').child(auth.uid).child('role').exists() && (root.child('users').child(auth.uid).child('role').val() === 'Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator')))"
      }
    },
    "artworks": {
      ".read": true,
      ".indexOn": [
        "artistId",
        "ownerId",
        "likesCount",
        "isForSale",
        "moderationStatus"
      ],
      "$artworkId": {
        ".write": "auth != null && ((!data.exists() && newData.child('artistId').val() === auth.uid) || (data.child('ownerId').val() === auth.uid) || (root.child('users').child(auth.uid).child('role').exists() && (root.child('users').child(auth.uid).child('role').val() === 'Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator')))",
        ".validate": "newData.hasChildren(['title', 'imageUrl', 'artistId', 'ownerId', 'createdAt'])",
        "likesCount": {
          ".write": "auth != null"
        },
        "commentsCount": {
          ".write": "auth != null"
        }
      }
    },
    "comments": {
      ".read": true,
      ".indexOn": [
        "createdAt"
      ],
      "$artworkId": {
        "$commentId": {
          ".write": "auth != null && ((!data.exists() && newData.child('userId').val() === auth.uid) || data.child('userId').val() === auth.uid)",
          ".validate": "newData.hasChildren(['userId', 'text', 'createdAt'])"
        }
      }
    },
    "bookings": {
      ".read": "auth != null && ( (query.orderByChild == 'clientId' && query.equalTo == auth.uid) || (query.orderByChild == 'artistId' && query.equalTo == auth.uid) || root.child('users').child(auth.uid).child('role').val() === 'Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator' )",
      ".indexOn": [
        "clientId",
        "artistId"
      ],
      "$bookingId": {
        ".read": "auth != null && (data.child('clientId').val() === auth.uid || data.child('artistId').val() === auth.uid || (root.child('users').child(auth.uid).child('role').exists() && (root.child('users').child(auth.uid).child('role').val() === 'Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator')))",
        ".write": "auth != null && (data.child('clientId').val() === auth.uid || data.child('artistId').val() === auth.uid || newData.child('clientId').val() === auth.uid || newData.child('artistId').val() === auth.uid || (root.child('users').child(auth.uid).child('role').exists() && (root.child('users').child(auth.uid).child('role').val() === 'Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator')))",
        ".validate": "newData.hasChildren(['clientId', 'artistId', 'bookingDate', 'status', 'createdAt']) && (!data.child('paymentTxHash').exists() || newData.child('paymentTxHash').exists() || (root.child('users').child(auth.uid).child('role').val() === 'Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator')) && (!data.child('cancellationTxHash').exists() || newData.child('cancellationTxHash').exists() || (root.child('users').child(auth.uid).child('role').val() === 'Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator')) && (!data.child('depositConfirmedAt').exists() || newData.child('depositConfirmedAt').exists() || (root.child('users').child(auth.uid).child('role').val() === 'Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator')) && (!data.child('refundConfirmedAt').exists() || newData.child('refundConfirmedAt').exists() || (root.child('users').child(auth.uid).child('role').val() === 'Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator'))",
        "paymentTxHash": {
          ".validate": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator')"
        },
        "cancellationTxHash": {
          ".validate": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator')"
        },
        "depositConfirmedAt": {
          ".validate": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator')"
        },
        "refundConfirmedAt": {
          ".validate": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator')"
        },
        "depositAmount": {
          ".validate": "!data.exists() || newData.val() >= data.val() || root.child('users').child(auth.uid).child('role').val() === 'Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator'"
        },
        "status": {
          ".validate": "newData.val() !== 'confirmed' || data.val() === 'confirmed' || !root.child('bookings').child($bookingId).child('depositAmount').exists() || root.child('bookings').child($bookingId).child('depositAmount').val() <= 0 || root.child('users').child(auth.uid).child('role').val() === 'Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator'"
        }
      }
    },
    "reviews": {
      ".read": true,
      ".indexOn": [
        "revieweeId",
        "bookingId"
      ],
      "$reviewId": {
        ".write": "auth != null && !data.exists() && newData.child('authorId').val() === auth.uid",
        ".validate": "newData.hasChildren(['bookingId', 'rating', 'authorId', 'revieweeId', 'createdAt'])"
      }
    },
    "products": {
      ".read": true,
      ".indexOn": "ownerId",
      "$productId": {
        ".write": "auth != null && ((!data.exists() && newData.child('ownerId').val() === auth.uid) || (data.child('ownerId').val() === auth.uid) || (root.child('users').child(auth.uid).child('role').exists() && (root.child('users').child(auth.uid).child('role').val() === 'Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator')))",
        ".validate": "newData.hasChildren(['name', 'imageUrl', 'ownerId', 'createdAt', 'externalLink'])"
      }
    },
    "platform_settings": {
      ".read": true,
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator' || root.child('users').child(auth.uid).child('role').val() === 'Administrator')"
    },
    "userSessions": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "chats": {
      ".indexOn": [
        "lastMessage/timestamp",
        "participants"
      ],
      "$chatId": {
        ".read": "auth != null && data.child('participants').child(auth.uid).exists()",
        ".write": "auth != null && ((!data.exists() && newData.child('participants').child(auth.uid).exists()) || data.child('participants').child(auth.uid).exists())"
      }
    },
    "messages": {
      "$chatId": {
        ".read": "auth != null && root.child('chats').child($chatId).child('participants').child(auth.uid).exists()",
        ".write": "auth != null && root.child('chats').child($chatId).child('participants').child(auth.uid).exists()",
        ".indexOn": "timestamp"
      }
    },
    "userChats": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "referrals": {
      ".read": true,
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator')"
    },
    "deletionLogs": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'Super-Administrator')"
    },
    "worldId_nullifiers": {
      ".read": false,
      ".write": false
    }
  }
}
